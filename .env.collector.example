# Used only by npm run start:collector / dev:collector, never by the client.
# Do not start a second ingestion worker for an existing production collector.
HOST=127.0.0.1
PORT=4332
TRENDS_DATA_DIR=./data/collector
# Required, random base64url/hex string of at least 32 characters; same token in API .env.
TRENDS_API_TOKEN=
# Optional GitHub read token; otherwise the original anonymous budget is used.
GITHUB_TOKEN=
# Existing GitHub App credentials may be used instead of GITHUB_TOKEN.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
TRENDS_MAX_REPOS=300
TRENDS_ARCHIVE_ENABLED=false

# Server only. Supply values through the existing secret manager for live data.
TRENDS_REMOTE_URL=
TRENDS_API_TOKEN=
# Without collector configuration, the API returns a clearly labeled demo catalog.
# Production must set DATA_MODE=live; live mode fails closed on missing configuration.
DATA_MODE=demo
HOST=127.0.0.1
PORT=4321
# Required in production. Trusted origin for canonical/Open Graph URLs; never derived from Host.
PUBLIC_ORIGIN=http://127.0.0.1:4321
# Indexing is deliberately disabled in this release candidate pending live-data gates.

# Development only: permit http://127.0.0.1 or http://[::1] for an explicitly started local collector.
# Production always requires HTTPS, even if this flag is true.
ALLOW_LOCAL_COLLECTOR=false
